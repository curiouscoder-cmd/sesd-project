generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  groups       GroupMember[]
  createdGroups Group[]       @relation("GroupCreator")
  paidExpenses Expense[]     @relation("ExpensePaidBy")
  splits       Split[]       @relation("SplitOwes")
  sentSettlements  Settlement[] @relation("SettlementPaidBy")
  receivedSettlements Settlement[] @relation("SettlementPaidTo")

  @@map("users")
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String
  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator     User          @relation("GroupCreator", fields: [createdBy], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]

  @@map("groups")
}

model GroupMember {
  id       Int @id @default(autoincrement())
  groupId  Int
  userId   Int
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_members")
}

model Expense {
  id          Int       @id @default(autoincrement())
  description String
  amount      Decimal   @db.Decimal(10, 2)
  paidById    Int
  groupId     Int
  splitType   SplitType
  createdAt   DateTime  @default(now())

  paidBy Group   @relation(fields: [groupId], references: [id])
  group  User    @relation("ExpensePaidBy", fields: [paidById], references: [id])
  splits Split[]

  @@map("expenses")
}

model Split {
  id        Int     @id @default(autoincrement())
  expenseId Int
  owesId    Int
  amount    Decimal @db.Decimal(10, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  owes    User    @relation("SplitOwes", fields: [owesId], references: [id])

  @@map("splits")
}

model Settlement {
  id        Int      @id @default(autoincrement())
  groupId   Int
  paidById  Int
  paidToId  Int
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  group  Group @relation(fields: [groupId], references: [id])
  paidBy User  @relation("SettlementPaidBy", fields: [paidById], references: [id])
  paidTo User  @relation("SettlementPaidTo", fields: [paidToId], references: [id])

  @@map("settlements")
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}
